{
  "name": "scoutflow",
  "version": "0.3.0",
  "description": "Personal freelance lead discovery bot monitoring Facebook groups and other platforms",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "setup": "node scripts/setup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "telegram",
    "telegraf",
    "facebook",
    "scraper",
    "lead-generation",
    "freelance"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0",
    "joi": "^17.12.3",
    "axios": "^1.6.8",
    "uuid": "^9.0.1",
    "playwright": "^1.42.1",
    "firebase-admin": "^11.11.1",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}